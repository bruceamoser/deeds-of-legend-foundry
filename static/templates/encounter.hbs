<section class="hol-tool-shell hol-approved-tool">
  <header class="hol-tool-banner"><strong>{{currentName}}</strong><small>Round {{round}}</small></header>
  <div class="hol-tool-content">
    {{#if canOpen}}
      <div class="hol-tool-actions">
        <button type="button" data-action="opening">Opening roll</button>
        {{#if canAmbush}}<button type="button" data-action="ambush">Ambush</button>{{/if}}
      </div>
      <p>One player rolls unmodified 3d6. Allies start on 12+, enemies on 11 or less.</p>
    {{/if}}
    {{#if startingSide}}<p>{{opening}} · {{startingSide}} · 6 seconds per round.</p>{{/if}}
    <div class="hol-combat-roster">
      {{#each groups}}
        <section class="hol-combat-group">
          <strong class="hol-combat-group-title">{{label}}</strong>
          {{#each participants}}
            <div class="hol-combat-row {{#if active}}active{{/if}}">
              <button type="button" class="hol-combat-portrait-button" data-action="actor" data-id="{{id}}" aria-label="Open {{name}}"><img class="hol-combat-portrait" src="{{img}}" alt=""></button>
              <strong>{{name}}</strong>
              <div class="hol-combat-row-actions">
                {{#if canChoose}}<button type="button" data-action="choose" data-id="{{id}}">Take Turn</button>{{/if}}
                {{#if active}}<span>Active</span>{{else}}{{#if acted}}<span>✓ Acted</span>{{/if}}{{/if}}
                {{#if @root.canSetSide}}
                  <button type="button" data-action="side" data-id="{{id}}" data-side="{{destination}}" title="{{moveLabel}}" aria-label="{{moveLabel}}" {{#if active}}disabled{{/if}}>
                    <i class="fa-solid {{moveIcon}}" aria-hidden="true"></i>
                  </button>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </section>
      {{else}}<p>No participants.</p>{{/each}}
    </div>
    {{#if canFinish}}
      <div class="hol-tool-actions">
        {{#if canCancel}}<button type="button" data-action="cancel">Cancel Turn</button>{{/if}}
        <button type="button" data-action="finish" class="hol-primary">Finish turn</button>
      </div>
    {{/if}}
    {{#if canEnd}}<div class="hol-tool-actions"><button type="button" data-action="end">End combat</button></div>{{/if}}
  </div>
</section>
