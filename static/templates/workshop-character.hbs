<section class="hol-native-workshop">
  {{#if workshopReady}}
    <div data-workshop-mount class="hol-workshop-mount" aria-label="Character Workshop">
      <img slot="actor-portrait" class="hero-mark" src="{{portraitUrl}}" data-portrait-image role="button" tabindex="0"
        {{#if canCreate}}data-action="editImage" data-edit="img" alt="Edit character portrait"
        {{else}}data-action="viewPortrait" alt="View character portrait"{{/if}}>
    </div>
  {{else}}
    <div class="hol-workshop-entry">
      <h2>{{actorName}}</h2>
      {{#if legacy}}
        <p>This character is invalid under the current rules. Its existing data remains available through Foundry’s document export. Create a new hero with the current rules to play.</p>
        {{#if canCreate}}<button type="button" data-action="recreateWorkshop">Create new hero</button>{{/if}}
      {{else}}
        <p>The owner must create this hero first.</p>
      {{/if}}
    </div>
  {{/if}}
</section>
