<section class="hol-body hol-native-card hol-item-card hol-approved-item-card">
{{#if cardEditing}}
  <div class="hol-equipment-editor hol-card-scroll">
    <fieldset {{#unless editable}}disabled{{/unless}}>
      <div class="hol-equipment-edit-name"><img src="{{item.img}}" data-action="editImage" data-edit="img" alt="Item image" title="Change item image"><label>Name<input name="name" value="{{item.name}}"></label></div>
      <div class="hol-equipment-edit-values"><label>Quantity<input type="number" name="system.quantity" min="0" step="1" value="{{system.quantity}}"></label><label>Bulk per item<input type="number" name="system.bulk" min="0" step="1" value="{{system.bulk}}"></label>{{#if cardHasSupply}}<label>Supply die<select name="system.inventoryDie">{{#each supplyDieOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}</div>
      <label>Consumable type<select name="system.consumableType">{{#each consumableTypeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <p class="hol-equipment-effect-note">Effects apply while you carry and hold or wear this item.</p>
      <details class="hol-attribute-effects"><summary>Attribute effects</summary><p>For a curse override, choose the exact value and mark Cursed.</p>{{#each attributeEffectRows}}<div class="hol-attribute-effect-row" data-attribute-effect="{{attribute}}"><strong>{{label}}</strong><select data-effect-mode aria-label="{{label}} effect">{{#each modes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select><input data-effect-value aria-label="{{label}} effect value" type="number" step="1" value="{{value}}"><label><input data-effect-cursed type="checkbox" {{#if cursed}}checked{{/if}}> Cursed</label></div>{{/each}}</details>
      <details class="hol-attribute-effects"><summary>HP, SP and Speed</summary>
        <p>The highest equipped bonus to each stat applies.</p>
        <div class="hol-equipment-edit-values">{{#each bonusRows}}<label>{{label}}<input type="number" name="system.bonuses.{{key}}" min="0" step="1" value="{{value}}"></label>{{/each}}</div>
      </details>
      <details class="hol-attribute-effects"><summary>Damage resistance</summary>
        <div class="hol-equipment-edit-values">{{#each resistanceRows}}<label>{{label}}<input type="number" name="system.bonuses.{{key}}" min="0" max="3" step="1" value="{{value}}"></label>{{/each}}</div>
      </details>
      <label class="hol-equipment-description-label" for="equipment-description-{{item.id}}">Description</label>
      <prose-mirror id="equipment-description-{{item.id}}" name="system.description" value="{{editableDescription}}" data-document-uuid="{{item.uuid}}"></prose-mirror>
    </fieldset>
  </div>
  <footer class="hol-equipment-edit-footer"><button type="submit" class="hol-primary" {{#unless editable}}disabled{{/unless}}>Save changes</button></footer>
{{else}}
  <div class="hol-card-fixed"><div class="hol-card-toolbar">{{#if editable}}<button type="button" data-action="cardEdit">✎ Edit</button>{{/if}}</div>
  <header class="hol-item-header"><div class="hol-item-identity"><img class="hol-item-mark" src="{{cardMark}}" alt=""><div><h1>{{item.name}}</h1><p>Equipment</p></div></div><dl class="hol-item-vitals"><div><dt>Qty</dt><dd><input aria-label="Quantity" data-item-quantity type="number" min="0" step="1" value="{{system.quantity}}" {{#unless editable}}disabled{{/unless}}></dd></div><div><dt>Bulk</dt><dd>{{system.bulk}}</dd></div><div><dt>Coins</dt><dd>{{cardPrice}}</dd></div></dl></header></div>
  <div class="hol-card-scroll"><div class="hol-item-layout">
    <article class="hol-item-rule-card">{{#if customDescriptionHTML}}<div class="hol-item-rule-body hol-item-description">{{{customDescriptionHTML}}}</div>{{/if}}<div class="hol-item-rule-body" data-item-rules>{{{descriptionHTML}}}</div></article>
    {{#if torchAction}}<div class="hol-item-use"><button type="button" class="hol-primary" data-action="torch" {{#if torchAction.disabled}}disabled{{/if}}>{{torchAction.label}}</button></div>{{/if}}
    {{#if potion}}<div class="hol-item-use"><button type="button" class="hol-primary" data-action="usePotion">Use healing potion</button></div>{{/if}}
    <aside class="hol-item-boxes">
      {{#if equipmentEffectSummary}}<details open><summary>Equipment bonuses</summary>{{#each equipmentEffectSummary}}<div class="hol-item-stat-row"><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</details>{{/if}}
      {{#if attributeEffectSummary}}<details open><summary>Attribute effects</summary>{{#each attributeEffectSummary}}<div class="hol-item-stat-row"><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}</details>{{/if}}
      {{#if cardProperties}}<details data-card-section="properties" {{#unless cardCollapsed.properties}}open{{/unless}}><summary>Properties</summary>{{#each cardProperties}}<div class="hol-item-stat-row"><span>{{name}}</span><strong>{{value}}</strong></div>{{/each}}{{#if owned}}<button type="button" data-action="hands">Equipment arrangement</button>{{/if}}</details>{{else}}{{#if owned}}<details data-card-section="properties" {{#unless cardCollapsed.properties}}open{{/unless}}><summary>Properties</summary><button type="button" data-action="hands">Equipment arrangement</button></details>{{/if}}{{/if}}
      {{#if cardHasSupply}}<details data-card-section="supply" {{#unless cardCollapsed.supply}}open{{/unless}}><summary>Supply</summary><div class="hol-item-supply">{{#unless supplyTracking}}Untracked · {{/unless}}{{#if system.inventoryDie}}d{{system.inventoryDie}}{{else}}Empty{{/if}}</div>{{#if maximumSupplyDie}}<div class="hol-item-stat-row"><span>Maximum supply die</span><strong>d{{maximumSupplyDie}}</strong></div>{{/if}}{{#if canCheckSupply}}<button type="button" data-action="supply">Use supply</button><button type="button" data-action="deplete">Deplete</button>{{/if}}{{#if canResupply}}<button type="button" data-action="resupply">Resupply one step</button>{{/if}}</details>{{/if}}
      {{#if cardRequirements}}<details data-card-section="requirements" {{#unless cardCollapsed.requirements}}open{{/unless}}><summary>Requirements</summary>{{#each cardRequirements}}<div class="hol-item-stat-row"><span>{{name}}</span><strong>{{value}}</strong></div>{{/each}}</details>{{/if}}
    </aside>
    <details data-card-section="itemNotes" {{#unless cardCollapsed.itemNotes}}open{{/unless}}><summary>Notes</summary>{{#if cardEditing}}<textarea name="flags.heroes-of-legend.itemNotes" rows="3" maxlength="10000" placeholder="Notes for this item…">{{itemNotes}}</textarea>{{else}}<p class="hol-item-notes">{{#if itemNotes}}{{itemNotes}}{{else}}No notes.{{/if}}</p>{{/if}}</details>
  </div>
</div>
{{/if}}
</section>
