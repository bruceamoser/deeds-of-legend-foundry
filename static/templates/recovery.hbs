<section class="hol-tool-shell hol-approved-tool"><header class="hol-tool-banner"><h1>Recovery</h1><small>{{name}}</small></header><div class="hol-tool-content">
{{#if pendingGameplay}}<section class="hol-tool-box" role="alert"><p>A saved damage or condition action was interrupted. Complete its saved receipt before applying another resource change.</p><button type="button" data-action="retry">Complete saved action</button></section>{{/if}}
<div class="hol-tool-stats"><span>HP <b>{{basis.hp}} / {{basis.maxHp}}</b></span>{{#if character}}<span>Grit <b>{{basis.gritAvailable}}</b></span>{{#if dying}}<span>Death rolls <b>{{failed}} failures · {{successful}} successes</b></span>{{/if}}{{/if}}</div>
{{#if character}}<p>A Night’s Rest restores HP and SP. Use First Aid or learned recovery during a Brief Rest. Grit is a lifetime resource.</p>{{/if}}<div class="hol-tool-actions"><button type="button" data-action="operation" data-kind="heal">Healing</button>{{#if character}}<button type="button" data-action="operation" data-kind="grit">Spend Grit</button><button type="button" data-action="quick" data-kind="stabilize">Stabilize</button><button type="button" data-action="quick" data-kind="dawn">Next dawn</button>{{/if}}</div>
{{#if notice}}<p class="hol-tool-result" role="status">{{notice}}</p>{{/if}}
{{#if operation}}<section class="hol-tool-box"><input type="hidden" name="kind" value="{{operation}}">{{#if healing}}<h2>Healing</h2><label>Healing before Life resistance<input name="amount" type="number" min="0" step="1" value="6"></label><label>Additional Life resistance<input name="lifeResistance" type="number" min="0" step="1" value="0"></label>{{/if}}{{#if grit}}<h2>Spend 1 Grit</h2><p>Return to {{gritHp}} HP and clear both death tallies.</p>{{/if}}{{#if correction}}<label>Correct HP<input name="hp" type="number" min="0" max="{{basis.maxHp}}" step="1" value="{{basis.hp}}"></label>{{/if}}<p class="hol-tool-result" data-preview aria-live="polite"></p><button type="button" data-action="apply">Apply recovery</button></section>{{/if}}
<details><summary>Correct a mistake</summary><button type="button" data-action="operation" data-kind="correct">Correct HP</button></details><a href="#" data-hol-rule-path="design/rules/recovery.md">Read recovery rules</a>
</div></section>
